# ---------------------------------------------------------------------------
# Environment variables (copy to .env and fill in real values — never commit .env)
# ---------------------------------------------------------------------------

# Lovable AI Gateway key. Powers the AI chatbot (/api/chat), TTS (/api/tts)
# and authenticates connector-gateway calls. Auto-provisioned on Lovable.
LOVABLE_API_KEY=

# Gmail connector key (from the linked Gmail connection).
# Used by /api/contact to deliver contact-form messages.
GOOGLE_MAIL_API_KEY=

# Optional: inbox that receives contact-form submissions.
# Defaults to goursuryansh51@gmail.com
CONTACT_TO_EMAIL=

# ---------------------------------------------------------------------------
# Optional ElevenLabs voice cloning for the AI voice assistant (/api/tts).
# Create/authorize the voice in ElevenLabs Voice Lab, then set its Voice ID here.
# The voice sample is uploaded to ElevenLabs directly; this portfolio does not
# expose a public voice-training or sample-upload endpoint.
# When unset or unavailable, server TTS/browser speech synthesis remains the fallback.
# ---------------------------------------------------------------------------
VOICE_PROVIDER=elevenlabs
VOICE_ID=
VOICE_API_KEY=
VOICE_MODEL_ID=eleven_multilingual_v2
